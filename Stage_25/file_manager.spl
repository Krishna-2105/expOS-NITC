
alias fn_num R1;
alias arg1 R2;
alias arg2 R3;
alias arg3 R4;


// --------------------------------------------------
// BUFFER WRITE - function number 1
// --------------------------------------------------

if (fn_num == 1) then
    alias buffer_no R5;
    buffer_no = arg1 % 4;

    multipush(R1, R2, R3, R4, R5);
    R1 = 1;
    R2 = buffer_no;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5);

    R6 = BUFFER_TABLE + 4 * buffer_no;

    if ([R6] != arg1) then
        if ([R6 + 1] == 1) then
            multipush(R1, R2, R3, R4, R5, R6);
            R1 = 1;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = BUFFER_BASE + buffer_no;
            R4 = [R6];
            call DEVICE_MANAGER;
            multipop(R1, R2, R3, R4, R5, R6);

            [R6 + 1] = 0;
        endif;

        multipush(R1, R2, R3, R4, R5, R6);
        R1 = 2;
        R4 = arg1;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER_BASE + buffer_no;
        call DEVICE_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6);

        [R6] = arg1;
    endif;

    [(BUFFER_BASE + buffer_no) * 512 + arg2] = arg3;
    [R6 + 1] = 1;

    multipush(R1, R2, R3, R4, R5, R6);
    R1 = 2;
    R2 = buffer_no;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6);

    R0 = 0;
    return;
endif;


// --------------------------------------------------
// BUFFER READ - function number 2
// --------------------------------------------------

if (fn_num == 2) then
    alias buffer_no R5;
    buffer_no = arg1 % 4;

    multipush(R1, R2, R3, R4, R5);
    R1 = 1;
    R2 = buffer_no;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5);

    R6 = BUFFER_TABLE + 4 * buffer_no;

    if ([R6] != arg1) then
        if ([R6 + 1] == 1) then
            multipush(R1, R2, R3, R4, R5, R6);
            R1 = 1;
            R2 = [SYSTEM_STATUS_TABLE + 1];
            R3 = BUFFER_BASE + buffer_no;
            R4 = [R6];
            call DEVICE_MANAGER;
            multipop(R1, R2, R3, R4, R5, R6);

            [R6 + 1] = 0;
        endif;

        multipush(R1, R2, R3, R4, R5, R6);
        R1 = 2;
        R4 = arg1;
        R2 = [SYSTEM_STATUS_TABLE + 1];
        R3 = BUFFER_BASE + buffer_no;
        call DEVICE_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6);

        [R6] = arg1;
    endif;

    [arg3] = [(BUFFER_BASE + buffer_no) * 512 + arg2];

    multipush(R1, R2, R3, R4);
    R1 = 2;
    R2 = buffer_no;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4);

    R0 = 0;
    return;
endif;


// --------------------------------------------------
// OPEN - function number 3
// --------------------------------------------------

if (fn_num == 3) then
    alias inodeIndex R5;
    alias openFileTableEntry R6;
    alias statusEntry R7;
    alias lockResult R8;

    inodeIndex = 0;

    while (inodeIndex < MAX_FILE_NUM) do
        if ([INODE_TABLE + 16 * inodeIndex + 1] == arg1) then
            break;
        endif;
        inodeIndex = inodeIndex + 1;
    endwhile;

    if (inodeIndex >= MAX_FILE_NUM) then
        R0 = -1;
        return;
    endif;

    if ([INODE_TABLE + 16 * inodeIndex + 0] == EXEC) then
        R0 = -1;
        return;
    endif;

    // Acquire inode lock
    multipush(R1, R2, R3, R4, R5);
    R1 = 4;
    R2 = inodeIndex;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    lockResult = R0;
    multipop(R1, R2, R3, R4, R5);

    if (lockResult == -1) then
        R0 = -1;
        return;
    endif;

    // Find a free OFT entry
    openFileTableEntry = 0;

    while (openFileTableEntry < MAX_OPENFILE_NUM) do
        if ([OPEN_FILE_TABLE + 4 * openFileTableEntry] == -1) then
            break;
        endif;
        openFileTableEntry = openFileTableEntry + 1;
    endwhile;

    // If OFT is full, release inode before returning
    if (openFileTableEntry >= MAX_OPENFILE_NUM) then
        multipush(R1, R2, R3, R4, R5, R6);
        R1 = 5;
        R2 = inodeIndex;
        R3 = [SYSTEM_STATUS_TABLE + 1];
        call RESOURCE_MANAGER;
        multipop(R1, R2, R3, R4, R5, R6);

        R0 = -2;
        return;
    endif;

    // Initialize OFT entry
    if (arg1 == "root") then
        [OPEN_FILE_TABLE + 4 * openFileTableEntry] = INODE_ROOT;
    else
        statusEntry = FILE_STATUS_TABLE + 4 * inodeIndex;

        if ([statusEntry + 1] == -1) then
            [statusEntry + 1] = 1;
        else
            [statusEntry + 1] = [statusEntry + 1] + 1;
        endif;

        [OPEN_FILE_TABLE + 4 * openFileTableEntry] = inodeIndex;
    endif;

    [OPEN_FILE_TABLE + 4 * openFileTableEntry + 1] = 1;
    [OPEN_FILE_TABLE + 4 * openFileTableEntry + 2] = 0;

    // Release inode lock
    multipush(R1, R2, R3, R4, R5, R6);
    R1 = 5;
    R2 = inodeIndex;
    R3 = [SYSTEM_STATUS_TABLE + 1];
    call RESOURCE_MANAGER;
    multipop(R1, R2, R3, R4, R5, R6);

    R0 = openFileTableEntry;
    return;
endif;


// --------------------------------------------------
// CLOSE - function number 4
// --------------------------------------------------

if (fn_num == 4) then
    alias oftEntry R5;
    alias inodeIndex R6;
    alias statusEntry R7;

    oftEntry = OPEN_FILE_TABLE + 4 * arg1;
    inodeIndex = [oftEntry];

    // Defensive validation
    if (arg1 < 0 || arg1 >= MAX_OPENFILE_NUM) then
        R0 = -1;
        return;
    endif;

    if (inodeIndex == -1) then
        R0 = -1;
        return;
    endif;

    [oftEntry + 1] = [oftEntry + 1] - 1;

    if ([oftEntry + 1] <= 0) then
        // Invalidate this open instance
        [oftEntry] = -1;
        [oftEntry + 1] = 0;
        [oftEntry + 2] = -1;

        // Root is not tracked in FILE_STATUS_TABLE
        if (inodeIndex != INODE_ROOT) then
            statusEntry = FILE_STATUS_TABLE + 4 * inodeIndex;
            [statusEntry + 1] = [statusEntry + 1] - 1;

            if ([statusEntry + 1] <= 0) then
                [statusEntry + 1] = -1;
            endif;
        endif;
    endif;

    R0 = 0;
    return;
endif;

return;
